 "poems": [
  {
   "seq": "1",
   "text": "こそといへは久しくなれる心地して思へは夜半の隔てんけり",
   "kana": "",
   "speaker": "〔舊本行書躰〕",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "山人の筧にむすふ氷たにとけすはけふを春としらめや",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "さらぬたになこその關ときく物をいとゝ霞のたちへたつらむ",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "松かえにさかぬはかりぞ梅花いろはちとせもかはらさらなむ",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "櫻花今いくかあけてさかなんと枝ものいはゝとはましものを",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "詠めやる花し咲なはあちきなくまたぬあるしや我ものとみむ",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "雲のうへに風ものとけき春なれやちるともみえぬ花さくら哉",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "あかなくに袖につゝめはちる花を嬉しと思ふになりぬへき哉",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "櫻はな見しそのほとは思ひやれ散よりほかのなけきやはせし",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "遠方の風にみたるゝいとさくら我手にかけてみるよしもかな",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "琴のねにあかてやいまはかへりなむ花にとのみも思ひける哉",
   "kana": "",
   "speaker": "",
   "page": 122,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "とらぬたに玉江の水の〓きうへに光をうつすあきのよの月",
   "kana": "",
   "speaker": "實國卿集秋",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "あはつ野になくよの數のつもれるは鹿もよ妻やつれなかる覽",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "あかほしのあかて出にしあかつきは今宵の月に思ひいてすや",
   "kana": "",
   "speaker": "隆信朝臣",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "たゝこゝにたゝ夏にとそ思ひしにけは八月のかひもなかりき",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "紅葉ちるあらしの山のやまもりはおもひもたゝぬ錦をやきる",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "をとは山ぬさとちりかふ紅葉はをせきもる神やわか物とみる",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "もろともに君とみぬまのもみぢはゝ心のやみのにしき成けり",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "暮行をおしむにつくるこゝろ社秋のこよひのたくひなりけれ",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "おもひなく花色ころもぬくはかりそめし心のまつかはれかし",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "山さとのかきれならひの卯花やをとなし河のせゞのしら浪",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "我はゝやきゝつといはむほとゝきす人のまとろむ時のまも哉",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "なこりなくすきぬなるかな時鳥こそかたらひし人としらすや",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "あまをふねさして入えのこもかくれ水うつ棹の音のみそする",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "五月雨は賤のしのやのしのすかきふしところまて水はきに鳬",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "朽にける板まにもれるさみたれのふるやくるしき我住ゐかな",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "月きよみなかめもあへす明るよや秋にかはれるしるし成らむ",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "をやみては又をとつるゝ村時雨幾たひとといふに鳥のなく覽",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "杉はらや三輪の山へに雪ふりてけふこそ冬のしるしとはみれ",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "朝またきかりはの小野に雪ふれはしらふにならぬ箸鷹そなき",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "旅ねするすまのせきやに夢さめて我よすからのともちとり哉",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "かけひにはつらゝゐにけり山人の朝け夕けの水いかゞする",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "こひそめし心のはなの色ふかみ風のつてにもまたしらしかし",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "八重霞はれぬ思ひはそれなからいくたひ春のかはりきぬらむ",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "つゝめともたえぬにひけるあやめ草我心ねそあらはれにける",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "きゝもせすきかぬしもなきこゑゆへにあるもあられす山時鳥",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "なけきつゝかくてやきえむ白雪のしられむまての命ともかな",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "さきのよに我に心や盡しけむむくひならすはかゝらましやは",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "あふとはとをくにみゆるしきしまの道にまとへる我心かな",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "戀しなは我ゆへとたにおもひ出よさこそはつらき心なりとも",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "おもひあまりけぬへきものをいかなれは戀を命と人のいひ劔",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "汐たるゝ我やいせおの蜑ならんさらはみるめをかるよしも哉",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "ぬれしとて思ひかへさに思ひしれよをしる雨はさそ處せき",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "とけかたみこゝろと見しは氷室山たゝ我からのつらゝ成けり",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "契りしをみとせまてこそまたさらめいつしかなりや新枕する",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "賴めをく今日はう月の御秡してきみをみあれの日社またるれ",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "ありしそのうきを忘れてたのみつるこよひもおなし僞にさは",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "さよ衣きてかされよと契りしをかへしてはさは夢にみよこや",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "五月雨の日をふるまゝにさはた川其たかはしは名のみんけり",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "ことしたにこゑなおしみそ郭公をのかさ月のそへるしるしに",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "今もさは昔もきかすほとゝきすいとふためしに君やなりなん",
   "kana": "",
   "speaker": "經正朝臣",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "足引の出時鳥いにしへもゝのゆふ人はいとひやはせぬ",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "夏虫をはいなくよそにおもふ哉これは此よにもゆるはかりそ",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "なつのよをうらみもはてし月影の名殘は秋もかくそ惜みし",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "見むといひし君もまちえぬたち花は花の盛もあちきなきかな",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "秋にしもゆきあふ〓とは七夕のなかきよとてやちきりそめけむ",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "棚機にあひそめ衣ぬきかさんかへる色をばいみもこそすれ",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "としに待あふ〓とよりもたなはたは中〓〓けふの暮や久しき",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "斯はかりいとふうき世をいかにして又かへりくる初雁の聲",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "夕まくれたひの空ゆく鴈金はふしみの田井やとまりなるらん",
   "kana": "",
   "speaker": "",
   "page": 123,
   "pid": "1879517",
   "form": "短歌",
   "genre": ""
  }
 ],
